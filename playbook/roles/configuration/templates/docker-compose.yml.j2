services:

  registry:
    image: registry:latest
    restart: always
    ports:
      - 5005:5005
    volumes:
      - /vardan/otus-jenkins/registry:/var/lib/registry
    hostname: registry
    environment:
      - REGISTRY_HTTP_ADDR=0.0.0.0:5005
      - OTEL_TRACES_EXPORTER=none
    networks:
      - selenoid_net1

  jenkins:
    image: jenkins/jenkins:lts
    hostname: jenkins
    privileged: true
    restart: always
    ports:
      - 6060:8080
    user: root
    depends_on:
      - registry
    environment:
      - JAVA_OPTS=-Dhudson.model.DownloadService.noSignatureCheck=true
      - DOCKER_OPTS=-H tcp://0.0.0.0:2376 -H unix:///var/run/docker.sock
      - DOCKER_HOST=unix:///var/run/docker.sock
      - JENKINS_OPTS=--prefix=/jenkins
    volumes:
      - /vardan/otus-jenkins/jenkins_home:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - selenoid_net1

  selenoid1:
    image: aerokube/selenoid:1.11.3
    environment:
      - DOCKER_API_VERSION=1.44
    container_name: selenoid1
    hostname: selenoid1
    networks:
      - selenoid_net1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./grid-router/browsers.json:/etc/selenoid/browsers.json:ro
    command: -container-network selenoid_net1 -limit 10 -timeout 2m

  selenoid2:
    image: aerokube/selenoid:1.11.3
    environment:
      - DOCKER_API_VERSION=1.44
    container_name: selenoid2
    hostname: selenoid2
    networks:
      - selenoid_net2
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./grid-router/browsers.json:/etc/selenoid/browsers.json:ro
    command: -container-network selenoid_net2 -limit 10 -timeout 2m


  wiremock:
    image: wiremock/wiremock:3.13.1
    hostname: wiremock
    ports:
        - "8081:8080"
    volumes:
        - "${PWD}/wiremock/stubs:/home/wiremock/mappings"
    networks:
        - selenoid_net1

  android-container:
    image: butomo1989/docker-android-arm-7.1.1
    container_name: android-container
    privileged: true
    ports:
      - "6080:6080"
      - "5554:5554"
      - "5555:5555"
      - "4723:4723"
    environment:
      - DEVICE=Samsung Galaxy S6
      - APPIUM=true
      - WEB_VNC=true
    volumes:
      - /home/vardan/wishlist.apk:/root/tmp/wishlist.apk
    restart: unless-stopped

  ggr:
    image: aerokube/ggr:1.7.2
    container_name: ggr
    hostname: ggr
    ports:
      - "4444:4444"
    depends_on:
      - selenoid1
      - selenoid2
    volumes:
      - ./grid-router:/etc/grid-router:ro
    command: -guests-allowed -guests-quota "vardan" -verbose -quotaDir /etc/grid-router/quota
    networks:
      - selenoid_net1
      - selenoid_net2

  ggr-ui:
    image: aerokube/ggr-ui:1.2.0
    container_name: ggr-ui
    hostname: ggr-ui
    depends_on:
      - ggr
    volumes:
      - ./grid-router:/etc/grid-router:ro
    networks:
      - selenoid_net1
      - selenoid_net2

  selenoid-ui:
    image: aerokube/selenoid-ui:1.10.11
    container_name: selenoid-ui
    hostname: selenoid-ui
    ports:
      - "8080:8080"
    depends_on:
      - ggr-ui
    networks:
      - selenoid_net1
    command: --selenoid-uri http://ggr-ui:8888

  nginx:
    image: nginx:latest
    container_name: selenoid-nginx
    depends_on:
      - ggr
      - selenoid-ui
    ports:
      - "80:80"
    volumes:
      - ./nginx/selenoid.conf:/etc/nginx/conf.d/default.conf
    networks:
      - selenoid_net1

networks:
  selenoid_net1:
    name: selenoid_net1
  selenoid_net2:
    name: selenoid_net2
